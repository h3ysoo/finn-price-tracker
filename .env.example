# Anthropic API anahtarı — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Opsiyonel ayarlar (aşağıdakilerin hepsinin makul varsayılanı var) ---
# Yorumu kaldırıp değiştirerek geçersiz kılabilirsin.

# Kullanılacak Claude modeli
# CLAUDE_MODEL=claude-sonnet-5

# AI ile analiz edilecek en ucuz ilan sayısı (maliyet kontrolü)
# AI_ANALYSIS_LIMIT=5
# Aynı anda uçan en fazla Claude isteği
# AI_CONCURRENCY=3

# Varsayılan taranacak sayfa sayısı
# DEFAULT_PAGES=3
# Bu fiyatın altındaki ilanlar (aksesuar/kutu) elenir
# LISTING_MIN_PRICE=500

# Aynı arama bu kadar saat içinde tekrarlanırsa taramadan önbellekten sunulur (0 = kapalı)
# SEARCH_CACHE_TTL_HOURS=6
# Bu kadar gündür satılmış/kalkmış ilanlar temizlenir (0 = hiç silme)
# RETENTION_DAYS=60

# Veri konumu (varsayılan: proje içindeki data/ dizini)
# DATA_DIR=./data
